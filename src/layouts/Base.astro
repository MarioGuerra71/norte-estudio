---
import "@fontsource-variable/schibsted-grotesk/wght.css";
import "../styles/global.css";
import fontUrl from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/og.jpg" } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site).href;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { href: "/proyectos", label: "Proyectos" },
  { href: "/estudio", label: "Estudio" },
  { href: "/contacto", label: "Contacto" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f3ef" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>

    <header class="site-header wrap">
      <a href="/" class="wordmark" aria-label="Norte Estudio, inicio">Norte</a>
      <nav aria-label="Principal">
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap grid">
        <div class="f-brand">
          <p class="wordmark">Norte</p>
          <p class="muted small">Estudio de arquitectura · Sevilla</p>
        </div>
        <div class="f-col small">
          <p>C/ Feria, 88 · 41003 Sevilla</p>
          <p><a href="mailto:hola@norteestudio.example">hola@norteestudio.example</a></p>
        </div>
        <div class="f-col small muted">
          <p>
            <strong class="ink">Proyecto de demostración.</strong> Norte Estudio no existe: proyectos, personas, datos y
            dirección son ficticios. Las fotos son de{" "}
            <a href="https://unsplash.com/license">Unsplash</a> y muestran edificios sin relación con estos proyectos.
          </p>
          <p class="f-author">
            Diseño y desarrollo: <a href="https://github.com/MarioGuerra71" rel="author">Mario Guerra</a>
          </p>
        </div>
      </div>
    </footer>

    <style>
      .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        min-height: 4.5rem;
      }

      .wordmark {
        font-weight: 600;
        font-size: 1.25rem;
        letter-spacing: -0.03em;
        text-decoration: none;
      }

      nav ul {
        display: flex;
        gap: clamp(0.75rem, 2.5vw, 2.25rem);
        margin: 0;
        padding: 0;
        list-style: none;
      }

      nav a {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
        text-decoration: none;
        font-size: 0.9375rem;
      }

      nav a[aria-current="page"] {
        color: var(--ladrillo);
        text-decoration: underline;
        text-decoration-thickness: 1px;
      }

      .site-footer {
        margin-top: clamp(5rem, 12vw, 9rem);
        padding-block: 3rem 3.5rem;
        border-top: 1px solid var(--piedra);
      }

      .site-footer .grid {
        row-gap: 1.75rem;
      }

      .f-brand,
      .f-col {
        grid-column: 1 / -1;
        display: grid;
        gap: 0.35rem;
        align-content: start;
      }

      .f-author {
        margin-top: 0.75rem;
      }

      .ink {
        color: var(--grafito);
        font-weight: 500;
      }

      @media (min-width: 48rem) {
        .f-brand {
          grid-column: 1 / 5;
        }

        .f-col:nth-of-type(2) {
          grid-column: 5 / 8;
        }

        .f-col:nth-of-type(3) {
          grid-column: 8 / 13;
        }
      }
    </style>
  </body>
</html>
